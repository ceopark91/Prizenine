# ------------------------------------------------------------------
# 탑뷰 픽 스튜디오 (Vercel Hub) 환경 변수
# .env.example 를 복사해 .env.local 로 만들고 값을 채우세요.
#
#   cp .env.example .env.local
#
# Vercel 대시보드의 프로젝트 > Settings > Environment Variables 에도
# 아래 항목들을 추가하면 배포 시 자동 반영됩니다.
# ------------------------------------------------------------------

# ---- Google Sheets 연동 (필수) -----------------------------------
# 서비스 계정의 이메일 (Google Cloud IAM > 서비스 계정)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# 서비스 계정 JSON 키 파일의 private_key 값
# (개행은 \n 으로 넣거나, Vercel 에선 Secret 로 관리)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 공유 대상 스프레드시트 ID (스프레드시트 URL 의 /d/ 이후 부분)
GOOGLE_SHEET_ID="your-spreadsheet-id"

# 시트 이름 (첫 번째 시트 기본값)
GOOGLE_SHEET_NAME="시트1"

# ---- 관리자 접근 (선택) ------------------------------------------
# /admin 페이지 보호용. 값이 비어 있으면 접근 제한 없음.
ADMIN_TOKEN=""

# ---- 유틸 (선택) --------------------------------------------------
# 숫자 상품번호 검색 등에서 사용
NEXT_PUBLIC_SITE_NAME="탑뷰 픽 스튜디오"

# ---- URL 수신 트리거 (필수: 외부 호출 시) -------------------------
INGEST_TOKEN="긴-랜덤-문자열"

# ---- Telegram webhook (선택) -------------------------------------
TELEGRAM_WEBHOOK_SECRET="서로-다른-랜덤-문자열"

# ---- 완료 알림 (선택) --------------------------------------------
ALERT_EMAIL="받을-이메일@example.com"
